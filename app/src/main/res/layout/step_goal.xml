<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start">

    <!-- Small overline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STEP 3 OF 3"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:textColor="#9CA3AF"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="What’s your\nfinal goal?"
        android:lineSpacingExtra="4dp"
        style="@style/IOSLargeTitle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="This is to keep you motivated."
        style="@style/IOSBody"
        android:alpha="0.65" />

    <!-- Input with floating label feel -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Your goal"
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/etGoal"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rounded_edit"
        android:hint="e.g. Become healthier, build discipline..."
        android:padding="20dp"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:textColorHint="#C0C5CE"
        android:gravity="top"
        android:inputType="textMultiLine" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="36dp"
        android:text="Start Floow 🚀"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:backgroundTint="@color/accent"
        app:strokeWidth="1dp"
        app:strokeColor="#E5E5EA"
        app:cornerRadius="16dp"
        app:elevation="0dp" />

</LinearLayout>