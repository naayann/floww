<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFDF9"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#EAE6DC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/cardBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFDF9"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="14dp"
            android:background="#C28A69" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJournalDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONDAY, OCT 21"
                android:textColor="#8C8B7F"
                android:textSize="10sp"
                android:letterSpacing="0.09"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvJournalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="A thought worth keeping"
                android:textColor="#30332D"
                android:textSize="18sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJournalContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="A little preview of what you wrote goes here..."
                android:textColor="#77796F"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="READ PAGE  →"
                android:textColor="#A16D4D"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
