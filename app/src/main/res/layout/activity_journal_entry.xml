<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="0dp"
    app:cardBackgroundColor="#FEF9C3"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Editor toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close editor"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="#5D6157" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvEditorMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JOURNAL PAGE"
                android:textColor="#A16D4D"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Direct Heading Input at Top -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@null"
            android:hint="Page title..."
            android:inputType="textCapSentences"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#30332D"
            android:textColorHint="#B1ADA2"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tuesday, October 21"
            android:textColor="#898A7F"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#E7E2D8" />

        <EditText
            android:id="@+id/etContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:background="@null"
            android:gravity="top|start"
            android:hint="What's on your mind today?\n\n\n"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            android:textColor="#55594F"
            android:textColorHint="#AAA99E"
            android:textSize="16sp"
            android:lineSpacingExtra="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#A96F4E"
            app:cornerRadius="18dp"
            app:elevation="0dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="#FFFFFF" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
