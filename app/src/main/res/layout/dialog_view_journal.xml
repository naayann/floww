<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FBF9F4"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeColor="#E8E2D8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FROM YOUR JOURNAL"
                android:textColor="#A16D4D"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close journal entry"
                android:padding="11dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#62655B" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvJournalDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tuesday, October 21"
            android:textColor="#88897E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvJournalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="A thought worth keeping"
            android:textColor="#30332D"
            android:textSize="27sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:background="#C28A69" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls">

            <TextView
                android:id="@+id/tvJournalContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:paddingBottom="12dp"
                android:text="Your saved journal entry appears here."
                android:textColor="#55594F"
                android:textSize="15sp"
                android:lineSpacingExtra="7dp"
                android:breakStrategy="simple" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#E7E2D8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="A moment, kept."
            android:textColor="#969487"
            android:textSize="12sp"
            android:fontStyle="italic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteJournal"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="#A34F47"
                android:textSize="13sp"
                app:backgroundTint="#F3E6E1"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="#A34F47" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseAction"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Done"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:backgroundTint="#A96F4E"
                app:cornerRadius="14dp"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
