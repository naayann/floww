<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Main content -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Compact floating bottom navbar -->
    <LinearLayout
        android:id="@+id/bottomNavPill"
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_nav_pill"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Home -->
        <ImageView
            android:id="@+id/navHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_nav_item_active"
            android:clickable="true"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="Home"
            android:scaleType="fitCenter"
            app:tint="@color/nav_active" />

        <!-- Add Goal -->
        <ImageView
            android:id="@+id/btnPlus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_plus_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_plus"
            android:contentDescription="Add Goal"
            android:scaleType="fitCenter"
            app:tint="@color/white" />

        <!-- Profile -->
        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_nav_item_inactive"
            android:clickable="true"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_manage_profile"
            android:contentDescription="Profile"
            android:scaleType="fitCenter"
            app:tint="@color/nav_inactive" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>