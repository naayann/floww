<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome"
        style="@style/IOSLargeTitle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="What should we call you?"
        style="@style/IOSHeadline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="This is how you’ll appear in Floow."
        style="@style/IOSBody" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_rounded_edit"
        android:hint="Name"
        android:paddingHorizontal="20dp"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:inputType="textPersonName"
        android:maxLines="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/button_dark"
        app:cornerRadius="18dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>